@app.post("/api/analytics/clear-database")
async def api_clear_database(db: Session = Depends(get_db)):
    for m in [Score, Project, CheckInLog, Attendee, Team, RubricCriterion, Announcement, ScheduleItem]: db.query(m).delete()
    db.commit()
    # Default clean rubrics for live event
    db.add_all([
        RubricCriterion(name="Innovation & Originality", max_score=10.0, weight=0.30, order=1),
        RubricCriterion(name="Technical Craft & Execution", max_score=10.0, weight=0.30, order=2),
        RubricCriterion(name="UI/UX & Polish", max_score=10.0, weight=0.20, order=3),
        RubricCriterion(name="Presentation & Impact", max_score=10.0, weight=0.20, order=4)
    ])
    db.commit()
    await ws_manager.broadcast({"type": "SYSTEM_RELOAD", "data": {}})
    return {"status": "success", "message": "Clean production database initialized."}

