-2 bg-rose-600 text-white rounded-lg text-xs font-bold">Push Broadcast</button></div></form></div></div>
<div id="toast-container"></div>
<script>
const state={activeTab:'ops',currentRole:'organizer',ws:null,charts:{},stats:null,attendees:[],teams:[],projects:[],rubrics:[],leaderboard:[],announcements:[],schedule:[],html5QrScanner:null};
const audioCtx=new (window.AudioContext||window.webkitAudioContext)();
function playChime(ok=true){try{if(audioCtx.state==='suspended')audioCtx.resume();const osc=audioCtx.createOscillator(),g=audioCtx.createGain();osc.type=ok?'sine':'sawtooth';osc.frequency.setValueAtTime(ok?587.33:300,audioCtx.currentTime);osc.frequency.exponentialRampToValueAtTime(ok?880:220,audioCtx.currentTime+0.15);g.gain.setValueAtTime(0.3,audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(0.01,audioCtx.currentTime+0.3);osc.connect(g);g.connect(audioCtx.destination);osc.start();osc.stop(audioCtx.currentTime+0.3);}catch(e){}}
function showToast(t,m,type='info'){const c=document.getElementById('toast-container');if(!c)return;const el=document.createElement('div');el.className=`toast-card p-4 rounded-xl shadow-2xl flex items-start gap-3 border text-xs backdrop-blur-md ${type==='urgent'?'bg-rose-950/90 border-rose-500/50 text-rose-100 urgent-flash':type==='success'?'bg-emerald-950/90 border-emerald-500/50 text-emerald-100':'bg-slate-900/90 border-indigo-500/50 text-slate-100'}`;el.innerHTML=`<div class="flex-1"><h4 class="font-bold">${t}</h4><p class="opacity-90 mt-0.5">${m}</p></div><button onclick="this.parentElement.remove()" class="opacity-60 hover:opacity-100">&times;</button>`;c.appendChild(el);setTimeout(()=>{el.style.opacity='0';setTimeout(()=>el.remove(),400);},5000);}
function initWebSocket(){const p=window.location.protocol==='https:'?'wss:':'ws:';state.ws=new WebSocket(`${p}//${window.location.host}/ws`);const el=document.getElementById('ws-status');state.ws.onopen=()=>{if(el){el.innerHTML='<span class="w-2 h-2 rounded-full bg-emerald-400 live-pulse"></span> Live Sync Connected';el.className='px-3 py-1 bg-emerald-950/60 border border-emerald-500/40 rounded-full text-xs font-semibold text-emerald-300 flex items-center gap-2';}};state.ws.onmessage=(e)=>{try{const msg=JSON.parse(e.data);if(msg.type==='ANNOUNCEMENT_NEW'){showToast(`📢 ${msg.data.title}`,msg.data.content,msg.data.priority);if(msg.data.priority==='urgent')playChime(false);loadAnnouncements();}else if(msg.type==='CHECKIN_RECORDED'){showToast('🎟️ Verified',`${msg.data.full_name} checked in!`,'success');playChime(true);loadLiveStats();loadAttendees();}else if(msg.type==='LEADERBOARD_UPDATED'){showToast('🏆 Leaderboard Updated','New score submitted!','info');state.leaderboard=msg.data;renderLeaderboard();loadLiveStats();}else{loadLiveStats();loadTeams();}}catch(err){}};state.ws.onclose=()=>{if(el)el.innerHTML='<span class="w-2 h-2 rounded-full bg-rose-400"></span> Reconnecting...';setTimeout(initWebSocket,3000);};}
function switchTab(id){state.activeTab=id;document.querySelectorAll('.tab-panel').forEach(p=>p.classList.add('hidden'));document.querySelectorAll('.nav-btn').forEach(b=>{b.classList.remove('bg-indigo-600','text-white','border-indigo-400');b.classList.add('text-slate-400');});const p=document.getElementById(`tab-${id}`),b=document.getElementById(`btn-tab-${id}`);if(p)p.classList.remove('hidden');if(b){b.classList.add('bg-indigo-600','text-white','border-indigo-400');b.classList.remove('text-slate-400');}if(id==='ops')renderCharts();if(id==='checkin')setTimeout(initQrScanner,200);else stopQrScanner();}
function switchRole(r){state.currentRole=r;document.querySelectorAll('[data-role-perm]').forEach(e=>{const p=e.getAttribute('data-role-perm').split(',');if(p.includes('all')||p.includes(r))e.classList.remove('hidden');else e.classList.add('hidden');});showToast('Persona Switched',`Viewing as ${r.toUpperCase()}`,'info');}
async function loadLiveStats(){try{const res=await fetch('/api/analytics/live-stats'),d=await res.json();state.stats=d;document.getElementById('kpi-registered').innerText=d.attendance.total_registered;document.getElementById('kpi-checkin').innerText=`${d.attendance.checked_in_count} (${d.attendance.checkin_rate_pct}%)`;document.getElementById('kpi-teams').innerText=`${d.teams.total_teams} (${d.teams.team_formation_rate_pct}%)`;document.getElementById('kpi-judging').innerText=`${d.judging.judging_progress_pct}% (${d.judging.judged_count}/${d.judging.total_projects})`;const f=document.getElementById('live-checkin-feed');if(f&&d.recent_checkins){f.innerHTML=d.recent_checkins.map(i=>`<div class="flex justify-between py-2 px-3 bg-slate-800/40 rounded-lg border border-slate-700/40"><span class="font-bold text-slate-200">${i.name} <span class="text-[10px] text-indigo-300">(${i.role})</span></span><span class="font-mono text-slate-400">${i.time}</span></div>`).join('')||'<p class="text-slate-500 py-4 text-center">No check-ins yet.</p>';}renderCharts();}catch(e){}}
function renderCharts(){if(!state.stats||!window.Chart)return;const cr=document.getElementById('chart-roles'),ct=document.getElementById('chart-tracks');if(cr){if(state.charts.r)state.charts.r.destroy();state.charts.r=new Chart(cr,{type:'doughnut',data:{labels:Object.keys(state.stats.attendance.role_breakdown).map(k=>k.toUpperCase()),datasets:[{data:Object.values(state.stats.attendance.role_breakdown),backgroundColor:['#6366f1','#a855f7','#10b981','#f59e0b','#06b6d4'],borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'right',labels:{color:'#cbd5e1',font:{size:10}}}}}});}if(ct){if(state.charts.t)state.charts.t.destroy();state.charts.t=new Chart(ct,{type:'bar',data:{labels:Object.keys(state.stats.teams.tracks),datasets:[{data:Object.values(state.stats.teams.tracks),backgroundColor:'#38bdf8',borderRadius:6}]},options:{responsive:true,maintainAspectRatio:false,scales:{x:{ticks:{color:'#94a3b8',font:{size:10}},grid:{display:false}},y:{ticks:{color:'#94a3b8',stepSize:1},grid:{color:'#334155'}}},plugins:{legend:{display:false}}}});}}
async function loadAttendees(){try{const r=document.getElementById('filter-attendee-role')?.value||'',s=document.getElementById('search-attendees')?.value||'',res=await fetch(`/api/attendees?role=${encodeURIComponent(r)}&search=${encodeURIComponent(s)}`),atts=await res.json();state.attendees=atts;const tb=document.getElementById('attendees-table-body');if(tb){tb.innerHTML=atts.map(a=>`<tr class="border-b border-slate-800 hover:bg-slate-800/30"><td class="py-3 px-4 font-bold text-slate-200">${a.first_name} ${a.last_name}<div class="text-[10px] text-slate-400">${a.email}</div></td><td class="py-3 px-4"><span class="px-2 py-0.5 rounded text-[10px] uppercase font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">${a.role}</span></td><td class="py-3 px-4 font-mono text-cyan-300">${a.registration_code}</td><td class="py-3 px-4 text-slate-300">${a.skills||'-'}</td><td class="py-3 px-4">${a.is_checked_in?'<span class="text-emerald-400 font-bold">&check; Verified</span>':'<span class="text-amber-400">Pending</span>'}</td><td class="py-3 px-4 text-right"><button onclick="previewBadge(${a.id})" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-indigo-300 rounded border border-slate-700"><i class="fa-solid fa-id-card"></i> Badge</button></td></tr>`).join('')||'<tr><td colspan="6" class="text-center py-6 text-slate-500">No attendees found.</td></tr>';}}catch(e){}}
async function registerNewAttendee(e){e.preventDefault();const fd=new FormData(document.getElementById('form-register-attendee')),res=await fetch('/api/attendees',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(fd))});if(res.ok){const a=await res.json();closeModal('modal-register');document.getElementById('form-register-attendee').reset();showToast('Registered',`${a.first_name} registered!`,'success');loadAttendees();loadLiveStats();previewBadge(a.id);}else{const err=await res.json();alert(err.detail||'Failed');}}
async function previewBadge(id){const res=await fetch(`/api/attendees/${id}/badge`),b=await res.json();document.getElementById('badge-preview-content').innerHTML=`<div class="bg-gradient-to-b from-slate-900 via-slate-800 to-slate-950 rounded-2xl border-2 border-indigo-500/50 shadow-2xl p-6 flex flex-col items-center text-center"><div class="text-[10px] font-bold text-cyan-400 uppercase tracking-widest mb-1">EventPulse Pass</div><h3 class="text-xs font-semibold text-slate-300 mb-2">Global AI & Innovation Summit</h3><span class="px-3 py-0.5 rounded-full text-xs font-black uppercase bg-indigo-500/20 text-indigo-300 border border-indigo-500/40 mb-3">${b.role}</span><h2 class="text-xl font-black text-white">${b.full_name}</h2><p class="text-xs text-slate-400 mb-3">${b.email}</p><div class="bg-white p-2.5 rounded-xl shadow-inner mb-3"><img src="${b.qr_code_image}" class="w-40 h-40"></div><div class="font-mono text-xs font-bold text-slate-300 mb-3">${b.registration_code}</div><div class="w-full grid grid-cols-3 gap-2 pt-3 border-t border-slate-700 text-[11px] text-slate-400"><div><span class="block text-[9px] uppercase">Diet</span><span class="text-slate-200 font-medium">${b.dietary||'None'}</span></div><div><span class="block text-[9px] uppercase">Size</span><span class="text-slate-200 font-medium">${b.tshirt||'L'}</span></div><div><span class="block text-[9px] uppercase">Table</span><span class="text-cyan-300 font-bold">${b.table||'N/A'}</span></div></div><button onclick="simulateFastCheckin('${b.registration_code}')" class="mt-4 w-full py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-bold"><i class="fa-solid fa-qrcode"></i> Test Scan Here</button></div>`;openModal('modal-badge-preview');}
async function submitCheckInCode(code){if(!code)code=document.getElementById('input-checkin-code')?.value;if(!code)return;const c=document.getElementById('checkin-result-card'),res=await fetch('/api/attendees/check-in',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({registration_code:code.trim()})}),data=await res.json();if(!data.success){playChime(false);c.innerHTML=`<div class="p-5 bg-rose-950/60 border-2 border-rose-500/60 rounded-xl text-rose-200"><h3 class="font-bold text-base">Invalid Pass</h3><p class="text-xs mt-1">${data.message}</p></div>`;}else if(data.is_duplicate){playChime(false);c.innerHTML=`<div class="p-5 bg-amber-950/60 border-2 border-amber-500/60 rounded-xl text-amber-200"><h3 class="font-bold text-base text-amber-300">Duplicate Check-in Alert</h3><p class="text-xs mt-1">${data.warning}</p><div class="mt-2 font-bold text-white">${data.attendee.first_name} ${data.attendee.last_name}</div></div>`;}else{playChime(true);const a=data.attendee;c.innerHTML=`<div class="p-5 bg-emerald-950/60 border-2 border-emerald-500/60 rounded-xl text-emerald-100 text-left"><div class="flex justify-between items-center"><h3 class="font-bold text-lg text-emerald-300">&check; Verified & Checked In!</h3><span class="px-2 py-0.5 rounded text-xs font-bold uppercase bg-emerald-500/20 text-emerald-300 border">${a.role}</span></div><div class="text-xl font-black text-white mt-1">${a.first_name} ${a.last_name}</div><div class="text-xs text-slate-300">${a.email} &bull; <span class="font-mono text-cyan-300 font-bold">${a.registration_code}</span></div><div class="grid grid-cols-2 gap-2 mt-4 p-2.5 bg-slate-900/80 rounded-lg border border-slate-700 text-xs"><div><span class="block text-[10px] text-slate-400 uppercase">Dietary</span><span class="font-bold text-amber-300">${a.dietary_requirements||'None'}</span></div><div><span class="block text-[10px] text-slate-400 uppercase">Swag Size</span><span class="font-bold text-cyan-300">Size ${a.tshirt_size||'L'}</span></div></div></div>`;}loadLiveStats();}
function simulateFastCheckin(c){switchTab('checkin');closeModal('modal-badge-preview');submitCheckInCode(c);}
function initQrScanner(){if(!window.Html5QrcodeScanner||state.html5QrScanner)return;state.html5QrScanner=new Html5QrcodeScanner("qr-reader",{fps:10,qrbox:240},false);state.html5QrScanner.render(code=>submitCheckInCode(code));}
function stopQrScanner(){if(state.html5QrScanner){try{state.html5QrScanner.clear();}catch(e){}state.html5QrScanner=null;}}
async function loadTeams(){const res=await fetch('/api/teams'),teams=await res.json();state.teams=teams;const c=document.getElementById('teams-grid-container');if(c){c.innerHTML=teams.map(t=>`<div class="glass-panel rounded-2xl p-5 border border-slate-700/60 glass-hover flex flex-col justify-between"><div><div class="flex justify-between items-start mb-2"><div><span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">${t.track}</span><h3 class="text-lg font-black text-white mt-1">${t.name}</h3></div><span class="px-2 py-0.5 rounded text-xs font-mono font-bold bg-slate-800 text-slate-300 border border-slate-700">Table ${t.table_number}</span></div><p class="text-xs text-slate-300 mb-3">${t.tagline||'Building innovation.'}</p><div class="mb-3"><div class="text-[10px] font-bold uppercase text-slate-500 mb-1">Roster (${t.member_count}/5)</div><div class="flex flex-wrap gap-1">${t.members.map(m=>`<span class="px-2 py-0.5 rounded text-[11px] bg-slate-800 text-slate-200 border border-slate-700">${m.first_name} ${m.last_name}</span>`).join('')}</div></div>${t.needed_skills?`<div class="mb-3"><div class="text-[10px] font-bold uppercase text-amber-400/90 mb-1">Wanted Skills</div><div class="flex flex-wrap gap-1">${t.needed_skills.split(',').map(s=>`<span class="px-2 py-0.5 rounded text-[10px] bg-amber-500/10 text-amber-300 border border-amber-500/20">${s.trim()}</span>`).join('')}</div></div>`:''}</div><div class="pt-3 border-t border-slate-800"><button onclick="openMatchmaking(${t.id})" class="w-full py-2 bg-indigo-600/30 hover:bg-indigo-600 text-indigo-200 hover:text-white rounded-lg text-xs font-bold border border-indigo-500/40 transition"><i class="fa-solid fa-wand-magic-sparkles text-cyan-400"></i> Match Candidates</button></div></div>`).join('')||'<div class="col-span-full text-center py-10 text-slate-500">No teams formed yet.</div>';}}
async function openMatchmaking(teamId){const res=await fetch(`/api/teams/${teamId}/matchmaking`),data=await res.json(),team=state.teams.find(t=>t.id===teamId);document.getElementById('matchmaking-team-title').innerText=`Smart Matches for "${team?.name||'Team'}"`;document.getElementById('matchmaking-results-container').innerHTML=data.recommendations.map(r=>`<div class="p-4 bg-slate-800/60 rounded-xl border border-slate-700 flex justify-between items-center gap-4"><div><div class="flex items-center gap-2"><h4 class="font-bold text-white text-sm">${r.name}</h4><span class="px-2 py-0.5 rounded-full text-xs font-black bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">${r.match_score}% Match</span></div><div class="flex flex-wrap gap-1 mt-1">${r.skills.map(s=>`<span class="px-1.5 py-0.5 rounded text-[10px] bg-slate-900 text-cyan-300 border">${s}</span>`).join('')}</div><div class="text-[11px] text-emerald-400 mt-1">${r.match_reasons.map(m=>`&check; ${m}`).join(' ')}</div></div><button onclick="addMember(${teamId}, ${r.attendee_id})" class="px-3 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-bold shrink-0">Add to Squad</button></div>`).join('')||'<p class="text-center py-6 text-slate-400 text-xs">No matching free agents right now.</p>';openModal('modal-matchmaking');}
async function addMember(teamId,attId){await fetch(`/api/teams/${teamId}/join?attendee_id=${attId}`,{method:'POST'});closeModal('modal-matchmaking');loadTeams();loadAttendees();loadLiveStats();showToast('Member Added','Teammate assigned!','success');}
async function createNewTeam(e){e.preventDefault();const fd=new FormData(document.getElementById('form-create-team')),solo=state.attendees.find(a=>a.role==='hacker'&&!a.team_id);if(!solo){alert('Please register a solo hacker attendee first.');return;}const res=await fetch('/api/teams',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:fd.get('name'),tagline:fd.get('tagline'),track:fd.get('track'),leader_id:solo.id,needed_skills:fd.get('needed_skills'),table_number:fd.get('table_number')||'T-AUTO'})});if(res.ok){closeModal('modal-create-team');loadTeams();loadAttendees();loadLiveStats();showToast('Team Created','Team is live!','success');}else alert('Failed');}
async function loadRubricsAndProjects(){const [rRes,pRes]=await Promise.all([fetch('/api/judging/rubrics'),fetch('/api/judging/projects')]);state.rubrics=await rRes.json();state.projects=await pRes.json();const sel=document.getElementById('judge-select-project');if(sel)sel.innerHTML='<option value="">-- Select Submission --</option>'+state.projects.map(p=>`<option value="${p.id}">${p.title} (${p.team_name} - ${p.track})</option>`).join('');const rub=document.getElementById('judge-rubric-sliders');if(rub){rub.innerHTML=state.rubrics.map(r=>`<div class="p-3 bg-slate-900 rounded-xl border border-slate-700"><div class="flex justify-between text-xs font-bold mb-1"><span class="text-white">${r.name} <span class="text-cyan-300">(${(r.weight*100).toFixed(0)}%)</span></span><span id="sv-${r.id}" class="text-indigo-400 font-mono">8.0 / 10</span></div><input type="range" min="0" max="${r.max_score}" step="0.5" value="8.0" data-crit-id="${r.id}" class="w-full accent-indigo-500" oninput="document.getElementById('sv-${r.id}').innerText=this.value+' / ${r.max_score}'"></div>`).join('');}}
async function submitJudgeScores(e){e.preventDefault();const pId=parseInt(document.getElementById('judge-select-project').value);if(!pId){alert('Select project');return;}const j=state.attendees.find(a=>a.role==='judge')||state.attendees.find(a=>a.role==='organizer');if(!j){alert('No judge found');return;}const scores=[];document.querySelectorAll('#judge-rubric-sliders input[type="range"]').forEach(i=>scores.push({criterion_id:parseInt(i.getAttribute('data-crit-id')),score_value:parseFloat(i.value)}));await fetch('/api/judging/scores',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({project_id:pId,judge_id:j.id,scores:scores,feedback:document.getElementById('judge-feedback-text').value})});showToast('Scores Recorded','Leaderboard updated!','success');loadLeaderboard();loadLiveStats();}
async function loadLeaderboard(){const track=document.getElementById('filter-leaderboard-track')?.value||'',res=await fetch(`/api/judging/leaderboard${track&&track!=='all'?`?track=${encodeURIComponent(track)}`:''}`);state.leaderboard=await res.json();renderLeaderboard();}
function renderLeaderboard(){const tb=document.getElementById('leaderboard-table-body');if(!tb)return;tb.innerHTML=state.leaderboard.map(i=>`<tr class="border-b border-slate-800 hover:bg-slate-800/40 text-xs"><td class="py-3 px-4 font-black">${i.rank===1?'🥇 1':i.rank===2?'🥈 2':i.rank===3?'🥉 3':i.rank}</td><td class="py-3 px-4"><div class="font-bold text-white text-sm">${i.project_title}</div><div class="text-[11px] text-slate-400">${i.team_name} &bull; Table ${i.table_number}</div></td><td class="py-3 px-4"><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">${i.track}</span></td><td class="py-3 px-4 font-mono">${i.judge_count} Judges</td><td class="py-3 px-4"><div class="flex items-center gap-2"><div class="w-20 bg-slate-700 h-2 rounded-full overflow-hidden"><div class="bg-gradient-to-r from-indigo-500 to-cyan-400 h-full" style="width:${i.percentage}%"></div></div><span class="font-mono text-cyan-300 font-bold">${i.percentage}%</span></div></td><td class="py-3 px-4 text-right font-mono font-black text-sm text-indigo-400">${i.weighted_score.toFixed(2)} / ${i.max_possible_score.toFixed(1)}</td></tr>`).join('')||'<tr><td colspan="6" class="text-center py-6 text-slate-500">No scored submissions yet.</td></tr>';}
async function loadAnnouncements(){const res=await fetch('/api/announcements');state.announcements=await res.json();const el=document.getElementById('announcements-feed');if(el)el.innerHTML=state.announcements.map(a=>`<div class="p-4 rounded-xl border ${a.priority==='urgent'?'bg-rose-950/40 border-rose-500/50 text-rose-100 urgent-flash':'bg-slate-800/60 border-slate-700 text-slate-200'}"><div class="flex justify-between items-center mb-1"><span class="px-2 py-0.5 rounded text-[10px] font-black uppercase ${a.priority==='urgent'?'bg-rose-500 text-white':'bg-indigo-500/20 text-indigo-300'}">${a.priority}</span><span class="text-[10px] text-slate-400">${new Date(a.created_at).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}</span></div><h4 class="font-bold text-sm text-white">${a.title}</h4><p class="text-xs opacity-90 mt-1">${a.content}</p></div>`).join('')||'<p class="text-center py-6 text-slate-500 text-xs">No announcements.</p>';}
async function postAnnouncement(e){e.preventDefault();const fd=new FormData(document.getElementById('form-announcement'));await fetch('/api/announcements',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(fd))});closeModal('modal-broadcast');loadAnnouncements();showToast('Broadcasted','Alert pushed!','success');}
async function loadSchedule(){const res=await fetch('/api/schedule');state.schedule=await res.json();const el=document.getElementById('schedule-timeline');if(el)el.innerHTML=state.schedule.map(s=>`<div class="relative pl-5 pb-5 border-l-2 ${s.is_active?'border-emerald-500':'border-slate-800'} last:pb-0 text-xs"><div class="absolute -left-[7px] top-0 w-3 h-3 rounded-full ${s.is_active?'bg-emerald-500 live-pulse':'bg-slate-900 border border-slate-700'}"></div><div class="p-3 rounded-xl border ${s.is_active?'bg-emerald-950/30 border-emerald-500/50':'bg-slate-800/40 border-slate-700/50'}"><div class="flex justify-between items-center"><span class="font-mono text-cyan-300 font-bold">${s.start_time} - ${s.end_time}</span>${s.is_active?'<span class="px-2 py-0.5 rounded text-[9px] font-black uppercase bg-emerald-500 text-slate-950">Happening Now</span>':''}</div><h4 class="font-bold text-white mt-1">${s.title}</h4><div class="text-[11px] text-slate-400 mt-1"><i class="fa-solid fa-location-dot text-rose-400"></i> ${s.location}</div>${!s.is_active?`<button onclick="setStageActive(${s.id})" data-role-perm="organizer" class="mt-2 px-2 py-1 bg-slate-800 text-slate-300 rounded text-[10px]">Set as Active Stage</button>`:''}</div></div>`).join('');}
async function setStageActive(id){await fetch(`/api/schedule/${id}/set-active`,{method:'POST'});loadSchedule();}
