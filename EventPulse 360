@app.post("/api/judging/scores")
async def api_submit_scores(req: SubmitScoresRequest, db: Session = Depends(get_db)):
    for e in req.scores:
        c = db.query(RubricCriterion).filter(RubricCriterion.id == e.criterion_id).first()
        if not c: continue
        sc = min(max(0.0, e.score_value), c.max_score)
        ex = db.query(Score).filter(Score.project_id == req.project_id, Score.judge_id == req.judge_id, Score.criterion_id == e.criterion_id).first()
        if ex: ex.score_value = sc; ex.feedback = req.feedback or ex.feedback
        else: db.add(Score(project_id=req.project_id, judge_id=req.judge_id, criterion_id=e.criterion_id, score_value=sc, feedback=req.feedback or ""))
    db.commit()
    await ws_manager.broadcast({"type": "LEADERBOARD_UPDATED", "data": calculate_leaderboard(db)})
    return {"status": "success"}

