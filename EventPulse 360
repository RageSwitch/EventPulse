async def lifespan(app: FastAPI):
    if DEMO_MODE:
        db = next(get_db())
        try: seed_event_data(db, force=False)
        finally: db.close()
    yield

app = FastAPI(title=APP_NAME, lifespan=lifespan)

@app.websocket("/ws")
async def ws_endpoint(ws: WebSocket):
    await ws_manager.connect(ws)
    try:
        while True:
            if await ws.receive_text() == "ping": await ws.send_text("pong")
    except WebSocketDisconnect: ws_manager.disconnect(ws)
    except Exception: ws_manager.disconnect(ws)

