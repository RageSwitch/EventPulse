@app.get("/api/analytics/live-stats")
def api_live_stats(db: Session = Depends(get_db)):
    attendees = db.query(Attendee).all()
    chk_count = sum(1 for a in attendees if a.is_checked_in)
    chk_rate = round((chk_count / len(attendees) * 100), 1) if attendees else 0.0
    teams = db.query(Team).all()
    hackers = [a for a in attendees if a.role == "hacker"]
    form_rate = round((sum(1 for h in hackers if h.team_id) / len(hackers) * 100), 1) if hackers else 0.0
    projects = db.query(Project).all()
    judged = len({s.project_id for s in db.query(Score).all()})
    progress = round((judged / len(projects) * 100), 1) if projects else 0.0

    recent = [{"name": l.attendee.full_name, "role": l.attendee.role, "time": l.timestamp.strftime("%H:%M:%S")} for l in db.query(CheckInLog).order_by(CheckInLog.timestamp.desc()).limit(6).all() if l.attendee]
    return {
        "attendance": {"total_registered": len(attendees), "checked_in_count": chk_count, "checkin_rate_pct": chk_rate, "role_breakdown": dict(Counter(a.role for a in attendees))},
        "teams": {"total_teams": len(teams), "team_formation_rate_pct": form_rate, "tracks": dict(Counter(t.track for t in teams))},
        "judging": {"total_projects": len(projects), "judged_count": judged, "judging_progress_pct": progress},
        "recent_checkins": recent
    }

