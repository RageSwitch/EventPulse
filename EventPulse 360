    lead = db.query(Attendee).filter(Attendee.id == team_in.leader_id).first()
    if not lead or lead.team_id: raise HTTPException(status_code=400, detail="Invalid leader.")
    t = Team(name=team_in.name.strip(), tagline=team_in.tagline or "", track=team_in.track or "General", leader_id=lead.id, needed_skills=team_in.needed_skills or "", table_number=team_in.table_number or "TBD")
