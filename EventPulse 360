    t = db.query(Team).filter(Team.id == team_id).first()
    a = db.query(Attendee).filter(Attendee.id == attendee_id).first()
    if not t or not a or a.team_id or len(t.members) >= MAX_TEAM_SIZE: raise HTTPException(status_code=400, detail="Cannot join.")
    a.team_id = t.id; a.is_looking_for_team = False; db.commit()
    await ws_manager.broadcast({"type": "TEAM_UPDATED", "data": {"name": t.name}})
    return {"status": "success"}

@app.get("/api/teams/{team_id}/matchmaking")
def api_team_matches(team_id: int, db: Session = Depends(get_db)):
    t = db.query(Team).filter(Team.id == team_id).first()
    if not t: return {"recommendations": []}
    t_exist = set().union(*[parse_skills(m.skills) for m in t.members])
    t_needed = parse_skills(t.needed_skills)
    free = db.query(Attendee).filter(Attendee.team_id == None, Attendee.role == "hacker", Attendee.is_looking_for_team == True).all()  # noqa: E711
    recs = []
    for att in free:
        comp = calculate_compatibility(parse_skills(att.skills), t_needed, t_exist, t.track)
        recs.append({"attendee_id": att.id, "name": att.full_name, "skills": att.skill_list, "match_score": comp["score"], "match_reasons": comp["reasons"]})
    recs.sort(key=lambda x: x["match_score"], reverse=True)
    return {"recommendations": recs[:8]}

