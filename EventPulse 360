@app.post("/api/attendees/check-in")
async def api_checkin(req: CheckInRequest, db: Session = Depends(get_db)):
    c = req.registration_code.strip()
    att = db.query(Attendee).filter(or_(Attendee.registration_code == c, Attendee.email.ilike(c))).first()
    if not att: return {"success": False, "message": f"Pass code '{c}' not found."}
    if att.is_checked_in:
        return {"success": True, "is_duplicate": True, "warning": "Already checked in.", "attendee": AttendeeResponse.model_validate(att)}
    att.is_checked_in = True; att.checked_in_at = utc_now()
    db.add(CheckInLog(attendee_id=att.id, scanned_by="Scanner Desk", check_in_station=req.station or "Gate 1", timestamp=utc_now()))
    db.commit()
    await ws_manager.broadcast({"type": "CHECKIN_RECORDED", "data": {"full_name": att.full_name, "role": att.role}})
    return {"success": True, "is_duplicate": False, "message": f"Verified {att.full_name}!", "attendee": AttendeeResponse.model_validate(att)}

