class ConnectionManager:
    def __init__(self): self.active_connections: List[WebSocket] = []
    async def connect(self, ws: WebSocket):
        await ws.accept()
        self.active_connections.append(ws)
    def disconnect(self, ws: WebSocket):
        if ws in self.active_connections: self.active_connections.remove(ws)
    async def broadcast(self, msg: Dict[str, Any]):
        payload = json.dumps(msg, default=str)
        for c in list(self.active_connections):
            try: await c.send_text(payload)
            except Exception: self.disconnect(c)

ws_manager = ConnectionManager()

def generate_registration_code(email: str, att_id: int) -> str:
    h = hashlib.sha256(f"{email}-{att_id}-{SECRET_KEY}".encode()).hexdigest()[:6].upper()
    return f"{QR_BADGE_PREFIX}-{att_id:04d}-{h}"

def generate_qr_base64(data: str) -> str:
    qr = qrcode.QRCode(version=1, box_size=8, border=2)
    qr.add_data(data); qr.make(fit=True)
    buf = io.BytesIO()
    qr.make_image(fill_color="#1E293B", back_color="#FFFFFF").save(buf, format="PNG")
    return f"data:image/png;base64,{base64.b64encode(buf.getvalue()).decode()}"

def parse_skills(s: str) -> Set[str]:
    return {x.strip().lower() for x in s.split(",") if x.strip()} if s else set()

def calculate_compatibility(att_skills: Set[str], team_needed: Set[str], team_exist: Set[str], track: str = "") -> Dict[str, Any]:
    score = 25.0
    reasons = []
    if team_needed:
        matches = att_skills.intersection(team_needed)
        if matches:
            score += (len(matches) / max(len(team_needed), 1)) * 45.0
            reasons.append(f"Matches needed: {', '.join(matches)}")
    novel = att_skills - team_exist
    if novel:
        score += min(30.0, len(novel) * 10.0)
        reasons.append(f"Adds new skills: {', '.join(list(novel)[:2])}")
    return {"score": min(100.0, round(score, 1)), "reasons": reasons}

def calculate_leaderboard(db: Session, track_filter: str = None) -> List[Dict[str, Any]]:
    criteria = db.query(RubricCriterion).order_by(RubricCriterion.order).all()
    if not criteria: return []
    tot_weight = sum(c.weight for c in criteria) or 1.0
    max_weighted = sum(c.max_score * c.weight for c in criteria) / tot_weight

    q = db.query(Project).filter(Project.is_submitted == True)
    if track_filter and track_filter.lower() != "all": q = q.filter(Project.track.ilike(track_filter))
    projects = q.all()

    lb = []
    for p in projects:
        t = db.query(Team).filter(Team.id == p.team_id).first()
        scores = db.query(Score).filter(Score.project_id == p.id).all()
        if not scores:
            lb.append({"rank": 0, "project_id": p.id, "project_title": p.title, "team_name": t.name if t else "Unknown", "track": p.track, "table_number": t.table_number if t else "N/A", "judge_count": 0, "weighted_score": 0.0, "max_possible_score": round(max_weighted, 2), "percentage": 0.0})
            continue

        c_scores = defaultdict(list)
        judges = set()
        for s in scores:
            judges.add(s.judge_id)
            c_scores[s.criterion_id].append(s.score_value)

        w_sum = sum((sum(c_scores[c.id]) / len(c_scores[c.id])) * c.weight for c in criteria if c_scores.get(c.id))
        final_w = w_sum / tot_weight
        pct = (final_w / max_weighted * 100.0) if max_weighted else 0.0
        lb.append({"rank": 0, "project_id": p.id, "project_title": p.title, "team_name": t.name if t else "Unknown", "track": p.track, "table_number": t.table_number if t else "N/A", "judge_count": len(judges), "weighted_score": round(final_w, 2), "max_possible_score": round(max_weighted, 2), "percentage": round(pct, 1)})

    lb.sort(key=lambda x: (x["weighted_score"], x["judge_count"]), reverse=True)
    for idx, item in enumerate(lb): item["rank"] = idx + 1
    return lb

