@app.post("/api/attendees")
async def api_register(att_in: AttendeeCreate, db: Session = Depends(get_db)):
    if db.query(Attendee).filter(Attendee.email == att_in.email).first():
        raise HTTPException(status_code=400, detail="Email already registered.")
    att = Attendee(registration_code="TEMP", first_name=att_in.first_name.strip(), last_name=att_in.last_name.strip(), email=att_in.email.strip().lower(), role=att_in.role, skills=att_in.skills or "", bio=att_in.bio or "", dietary_requirements=att_in.dietary_requirements or "None", tshirt_size=att_in.tshirt_size or "L", is_looking_for_team=att_in.is_looking_for_team)
    db.add(att); db.commit(); db.refresh(att)
    att.registration_code = generate_registration_code(att.email, att.id)
    db.commit(); db.refresh(att)
    await ws_manager.broadcast({"type": "ATTENDEE_REGISTERED", "data": {"id": att.id, "name": att.full_name}})
    return att

